# Copie este archivo como .env.local (ignorado por git) y complete los valores desde la consola de Neon.
# Nunca suba valores reales al repositorio.
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
SPACETRACK_ADMIN_EMAIL=admin@ejemplo.com
